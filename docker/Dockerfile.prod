# ===================================
# Dockerfile Multi-Stage pour Production
# TalentFlow - Optimisé pour performance et sécurité
# ===================================

# ===================================
# Stage 1: Base avec pnpm et optimisations de cache
# ===================================
FROM node:18-alpine AS base

# Installer pnpm globalement
RUN npm install -g pnpm@8.15.6

# Créer utilisateur non-root pour sécurité
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

WORKDIR /app

# Optimisation: Copier d'abord les fichiers de dépendances pour le cache Docker
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./

# ===================================
# Stage 2: Installation des dépendances de production
# ===================================
FROM base AS deps-prod

# Copier les fichiers de configuration pnpm
COPY pnpm-lock.yaml ./
COPY package.json ./
COPY pnpm-workspace.yaml ./

# Copier les package.json de tous les packages
COPY packages/database/package.json ./packages/database/
COPY packages/shared/package.json ./packages/shared/
COPY packages/validation/package.json ./packages/validation/
COPY packages/ui/package.json ./packages/ui/
COPY packages/testing/package.json ./packages/testing/
COPY apps/web/package.json ./apps/web/
COPY apps/api/package.json ./apps/api/

# Installer uniquement les dépendances de production pour optimiser la taille
RUN pnpm install --frozen-lockfile --prod

# ===================================
# Stage 3: Installation des dépendances de développement (pour le build)
# ===================================
FROM base AS deps-dev

# Copier les fichiers de configuration pnpm
COPY pnpm-lock.yaml ./
COPY package.json ./
COPY pnpm-workspace.yaml ./

# Copier les package.json de tous les packages
COPY packages/database/package.json ./packages/database/
COPY packages/shared/package.json ./packages/shared/
COPY packages/validation/package.json ./packages/validation/
COPY packages/ui/package.json ./packages/ui/
COPY packages/testing/package.json ./packages/testing/
COPY apps/web/package.json ./apps/web/
COPY apps/api/package.json ./apps/api/

# Installer toutes les dépendances pour le build
RUN pnpm install --frozen-lockfile

# ===================================
# Stage 3: Build des packages partagés
# ===================================
FROM base AS packages-builder

WORKDIR /app

# Copier les fichiers de configuration et les package.json
COPY pnpm-lock.yaml package.json pnpm-workspace.yaml turbo.json ./
COPY packages/database/package.json ./packages/database/
COPY packages/shared/package.json ./packages/shared/
COPY packages/validation/package.json ./packages/validation/
COPY packages/ui/package.json ./packages/ui/
COPY packages/testing/package.json ./packages/testing/
COPY apps/web/package.json ./apps/web/
COPY apps/api/package.json ./apps/api/

# Installer toutes les dépendances (dev incluses pour le build)
RUN pnpm install --frozen-lockfile

# Copier le code source des packages
COPY packages/ ./packages/

# Générer Prisma Client
RUN pnpm turbo db:generate

# Build des packages partagés
RUN pnpm turbo build --filter="@talentflow/database" --filter="@talentflow/shared" --filter="@talentflow/validation" --filter="@talentflow/ui"

# ===================================
# Stage 5: Build de l'API
# ===================================
FROM base AS api-builder

WORKDIR /app

# Copier les fichiers de configuration
COPY package.json pnpm-workspace.yaml turbo.json ./
COPY apps/api ./apps/api

# Copier les packages buildés
COPY --from=packages-builder /app/packages ./packages

# Copier les dépendances de production
COPY --from=deps-prod /app/node_modules ./node_modules

# Générer le client Prisma
RUN pnpm turbo db:generate

# Build de l'API
RUN pnpm turbo build --filter="@talentflow/api"

# ===================================
# Stage 6: Build de l'application Web
# ===================================
FROM base AS web-builder

WORKDIR /app

# Copier les fichiers de configuration
COPY package.json pnpm-workspace.yaml turbo.json ./
COPY apps/web ./apps/web

# Copier les packages buildés
COPY --from=packages-builder /app/packages ./packages

# Copier les dépendances de développement (nécessaires pour Next.js build)
COPY --from=deps-dev /app/node_modules ./node_modules

# Générer le client Prisma
RUN pnpm turbo db:generate

# Variables d'environnement pour le build
ARG NEXT_PUBLIC_API_URL
ARG NEXTAUTH_URL

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXTAUTH_URL=$NEXTAUTH_URL
ENV NODE_ENV=production

# Build de l'application Next.js
RUN pnpm turbo build --filter="@talentflow/web"

# ===================================
# Stage 6: Runtime API
# ===================================
FROM base AS api-runtime

WORKDIR /app

# Copier les dépendances de production
COPY --from=deps-prod /app/node_modules ./node_modules
COPY --from=packages-builder /app/packages ./packages

# Copier l'API buildée
COPY --from=api-builder /app/apps/api/dist ./apps/api/dist
COPY --from=api-builder /app/apps/api/package.json ./apps/api/

# Changer vers l'utilisateur non-root
USER nextjs

# Exposer le port
EXPOSE 3001

# Variables d'environnement
ENV NODE_ENV=production
ENV PORT=3001

# Commande de démarrage
CMD ["node", "apps/api/dist/main.js"]

# ===================================
# Stage 7: Runtime Web (Final)
# ===================================
FROM base AS web-runtime

WORKDIR /app

# Copier les dépendances de production nécessaires pour Next.js
COPY --from=deps-prod /app/node_modules ./node_modules
COPY --from=packages-builder /app/packages ./packages

# Copier l'application Next.js buildée
COPY --from=web-builder /app/apps/web/.next ./apps/web/.next
COPY --from=web-builder /app/apps/web/public ./apps/web/public
COPY --from=web-builder /app/apps/web/package.json ./apps/web/
COPY --from=web-builder /app/apps/web/next.config.js ./apps/web/

# Les fichiers de configuration sont déjà inclus dans les artefacts copiés

# Changer vers l'utilisateur non-root
USER nextjs

# Exposer le port
EXPOSE 3000

# Variables d'environnement
ENV NODE_ENV=production
ENV PORT=3000

# Commande de démarrage
CMD ["pnpm", "--filter=@talentflow/web", "start"]

# ===================================
# Métadonnées et Labels
# ===================================
LABEL org.opencontainers.image.title="TalentFlow"
LABEL org.opencontainers.image.description="Plateforme B2B SaaS pour la gestion des appels d'offres et candidats"
LABEL org.opencontainers.image.vendor="TalentFlow"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.source="https://github.com/your-org/talentflow"
